{
  "name": "@unimodular/logswap-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Logswap — typed wrappers over the LogswapManager / Router / Lens surface.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "contracts:sync": "bash scripts/sync-contracts.sh",
    "codegen": "npm run contracts:sync && forge build --root contracts && wagmi generate",
    "vectors": "bash scripts/gen-vectors.sh",
    "build": "npm run codegen && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist src/generated.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": { "viem": "^2.0.0" },
  "devDependencies": {
    "@wagmi/cli": "^2.1.0",
    "abitype": "^1.0.0",
    "typescript": "^5.4.0",
    "viem": "^2.21.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/unimodularxyz/logswap-sdk.git" }
}
